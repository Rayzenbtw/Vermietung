<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="10" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gfs.gfs2.HelloController">

    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

    <HBox alignment="CENTER">
        <Label text="Vermietung">
            <font>
                <Font name="System Bold" size="20" />
            </font>
        </Label>
    </HBox>

    <BorderPane VBox.vgrow="ALWAYS">

        <center>
            <VBox spacing="10" style="-fx-padding: 10;">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Vermieter Tabelle" />

                <TableView fx:id="vermieterTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="vNrCol" prefWidth="80" text="VNr" />
                        <TableColumn fx:id="nameCol" prefWidth="250" text="Name" />
                        <TableColumn fx:id="vornameCol" prefWidth="250" text="Vorname" />
                    </columns>
                </TableView>
            </VBox>
        </center>

        <right>
            <VBox prefWidth="350" spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #ddd;">

                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Vermieter hinzufügen" />
                <Separator />

                <Label text="Name:" />
                <TextField fx:id="nameField" promptText="z.B.: Müller" />

                <Label text="Vorname:" />
                <TextField fx:id="vornameField" promptText="z.B.: Hans" />

                <Button maxWidth="Infinity" onAction="#onCreate" prefHeight="40" text="CREATE" />

                <Separator />

                <Label style="-fx-font-weight: bold;" text="Verwaltung:" />

                <Button maxWidth="Infinity" onAction="#onUpdate" prefHeight="35" text="UPDATE" />

                <Button maxWidth="Infinity" onAction="#onDelete" prefHeight="35" text="DELETE" />

                <Button maxWidth="Infinity" onAction="#onRefresh" prefHeight="35" text="Aktualisieren (READ)" />

                <Separator />

            </VBox>
        </right>

    </BorderPane>

</VBox>
